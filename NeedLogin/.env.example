# 文件共享服务器配置文件
# 复制此文件为 .env 并修改配置

# 共享目录路径（Windows 路径使用反斜杠或双反斜杠）
# 示例: D:\shared 或 D:\\shared 或 C:\\Users\\YourName\\Documents\\Shared
SHARED_DIRECTORY=D:\files\myNetdisk

# 管理员用户名（用于创建第一个管理员账号，后续管理员可添加更多用户）
ADMIN_USERNAME=

# 管理员密码
ADMIN_PASSWORD=

# 服务器端口
PORT=5007

# 服务器主机（0.0.0.0 表示允许局域网访问，127.0.0.1 仅本机访问）
HOST=0.0.0.0

# 调试模式（生产环境设置为 False）
DEBUG=True

# 会话密钥（可选，不设置会自动生成）
# SECRET_KEY=your-secret-key-here
